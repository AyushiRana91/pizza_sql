
#Basic:
#1. Retrieve the total number of orders placed.
SELECT COUNT(*) AS total_orders 
FROM orders;

#2. Calculate the total revenue generated from pizza sales.
SELECT ROUND(SUM(order_details.quantity * pizzas.price), 2) AS total_revenue
FROM order_details
JOIN pizzas ON order_details.pizza_id = pizzas.pizza_id;


#3. Identify the highest-priced pizza.

SELECT pizza_types.name, pizzas.price 
FROM pizza_types 
JOIN pizzas ON pizza_types.pizza_type_id = pizzas.pizza_type_id 
ORDER BY pizzas.price DESC 
LIMIT 1;
 
#4.Identify the most common pizza size ordered.

SELECT pizzas.size, COUNT(order_details.order_details_id) AS order_count
FROM pizzas 
JOIN order_details ON pizzas.pizza_id = order_details.pizza_id
GROUP BY pizzas.size
ORDER BY order_count DESC
LIMIT 1;

#5. List the top 5 most ordered pizza types along with their quantities.
select pizza_types.name as pizza_name,sum(order_details.quantity) as total_quantity_ordered
FROM pizza_types
JOIN pizzas ON pizza_types.pizza_type_id = pizzas.pizza_type_id
JOIN order_details ON order_details.pizza_id = pizzas.pizza_id
GROUP BY pizza_types.name
ORDER BY total_quantity_ordered DESC
LIMIT 5;

#Intermediate:
#1. Join the necessary tables to find the total quantity of each pizza category ordered.
select pizza_types.name as pizza_name ,sum(order_details.quantity)as total_quantity_ordered
from pizza_types
JOIN pizzas ON pizza_types.pizza_type_id = pizzas.pizza_type_id
JOIN order_details ON order_details.pizza_id = pizzas.pizza_id
GROUP BY pizza_types.name
ORDER BY total_quantity_ordered desc;

#2. Determine the distribution of orders by hour of the day.

SELECT EXTRACT(HOUR FROM orders.time) AS order_hour,COUNT(order_id) AS total_orders
FROM orders
GROUP BY extract(hour from orders.time)
ORDER BY order_hour ;


#3. Join relevant tables to find the category-wise distribution of pizzas.
select category, count(name) as pizza_count
from pizza_types
group by category
order by pizza_count desc;

#4. Group the orders by date and calculate the average number of pizzas ordered per day.
SELECT ROUND(AVG(total_pizzas_per_day), 0) AS average_pizzas_per_day
FROM (SELECT orders.order_date AS day, SUM(order_details.quantity) AS total_pizzas_per_day
    FROM orders JOIN order_details ON orders.order_id = order_details.order_id
    GROUP BY orders.order_date
) AS daily_totals;

#5. Determine the top 3 most or dered pizza types based on revenue.

SELECT pt.name AS pizza_name, SUM(od.quantity * p.price) AS total_revenue
FROM pizza_types pt
JOIN pizzas p ON pt.pizza_type_id = p.pizza_type_id
JOIN order_details od ON p.pizza_id = od.pizza_id
GROUP BY pt.name
ORDER BY total_revenue DESC LIMIT 3;

#Advanced:
#1.Calculate the percentage contribution of each pizza type to total revenue.
SELECT pt.category, -- Change to pt.name if you want the individual pizza type name
    ROUND((SUM(od.quantity * p.price) / 
        (SELECT SUM(order_details.quantity * pizzas.price) FROM order_details 
         JOIN pizzas ON order_details.pizza_id = pizzas.pizza_id)) * 100, 2) AS revenue_percentage
FROM pizza_types pt
JOIN pizzas p ON pt.pizza_type_id = p.pizza_type_id
JOIN order_details od ON p.pizza_id = od.pizza_id
GROUP BY pt.category -- Match this with the column selected above
ORDER BY revenue_percentage DESC;

#2. Analyze the cumulative revenue generated over time.
SELECT category,transaction_date,daily_revenue, SUM(daily_revenue) OVER (PARTITION BY category 
        ORDER BY transaction_date
        ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS cumulative_revenue
FROM (-- Step 1: Aggregate revenue by category and date
    SELECT category,DATE(sale_timestamp) AS transaction_date, SUM(amount) AS daily_revenue
    FROM sales_transction
    GROUP BY category, DATE(sale_timestamp)) AS daily_sales
ORDER BY category, transaction_date;

#3.Determine the top 3 most ordered pizza types based on revenue for each pizza category.

WITH RevenueTable AS (SELECT pt.category,pt.name AS pizza_type,
        ROUND(SUM(od.quantity * p.price), 2) AS total_revenue
    FROM pizza_types pt
    JOIN pizzas p ON pt.pizza_type_id = p.pizza_type_id
    JOIN order_details od ON p.pizza_id = od.pizza_id
    GROUP BY pt.category, pt.name),
RankedPizzas AS (SELECT category, pizza_type, total_revenue,
        RANK() OVER (PARTITION BY category ORDER BY total_revenue DESC) as revenue_rank
    FROM RevenueTable)
SELECT category, pizza_type, total_revenue
FROM RankedPizzas
WHERE revenue_rank <= 3;
